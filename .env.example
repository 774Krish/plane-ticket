# ===== SkyVoyage — environment configuration =====
# Copy this file to `.env` and fill in your values.

# --- SerpAPI (Google Flights) — REAL airlines, specific dates, prices ---
# Get a free API key at https://serpapi.com (free tier: ~100 searches/month).
# This is the primary flight source when set.
SERPAPI_API_KEY=

# --- TravelPayouts (live flight prices) ---
# Get a free API token at https://www.travelpayouts.com
# (Sign up -> Tools -> API -> copy your token.)
# Used as a fallback (cheapest fares for the current month).
TRAVELPAYOUTS_TOKEN=

# Optional: your affiliate "marker". Adding it enables FULL itineraries
# (specific dates, airline names, flight numbers, times).
# Get it: dashboard -> Tools -> Affiliate -> Aviasales (join the program).
# Without a marker, the site shows cheapest fares for the current month.
TRAVELPAYOUTS_MARKER=

# Backend port (frontend proxies /api to this).
PORT=3001
